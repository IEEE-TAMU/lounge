# Public base URL of this app.
APP_BASE_URL=http://localhost:3000

# IEEE TAMU portal OIDC provider.
PORTAL_OIDC_ISSUER=http://localhost:4000
PORTAL_OIDC_CLIENT_ID=lounge-dev
PORTAL_OIDC_CLIENT_SECRET=lounge-dev-secret

# Session cookie signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-value

# Lounge music agent on ieee-tamu-5B.
MUSIC_AGENT_URL=http://192.168.1.10:8787
# Optional bearer token matching the agent's tokenFile.
MUSIC_AGENT_TOKEN=

# Optional tuning.
PLAYER_COOLDOWN_SECONDS=3
SESSION_MAX_AGE_SECONDS=28800
